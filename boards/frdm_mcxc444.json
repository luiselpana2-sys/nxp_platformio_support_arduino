{
  "name": "FRDM-MCXC444 (mcx-arduino-core)",
  "url": "https://github.com/teddokano/mcx-arduino-core",
  "vendor": "NXP",
  "frameworks": [
    "arduino"
  ],
  "build": {
    "core": "arduino",
    "cpu": "cortex-m0plus",
    "mcu": "cortex-m0plus",
    "f_cpu": "48000000UL",
    "variant": "frdm_mcxc444",
    "ldscript": "MCXC444.ld",
    "board_macro": "FRDM_MCXC444",
    "board_defines": [
      "-DCPU_MCXC444VLH",
      "-DTARGET_C444",
      "-DFRDM_MCXC444",
      "-DDISABLE_WDOG=0"
    ],
    "fpu_flags": [],
    "opt_flags": [
      "-O2"
    ]
  },
  "upload": {
    "maximum_size": 253952,
    "maximum_ram_size": 32768,
    "protocol": "linkserver",
    "protocols": [
      "linkserver"
    ],
    "linkserver_target": "MCXC444:FRDM-MCXC444"
  }
}
